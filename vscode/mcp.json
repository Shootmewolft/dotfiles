{
  "inputs": [
    {
      "description": "API key for authentication",
      "id": "CONTEXT7_API_KEY",
      "password": true,
      "type": "promptString"
    }
  ],
  "servers": {
    "Context7": {
      "args": [
        "-y",
        "@upstash/context7-mcp@latest"
      ],
      "command": "npx",
      "type": "stdio"
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    },
    "engram": {
      "args": [
        "mcp",
        "--tools=agent"
      ],
      "command": "/home/shoot/.local/bin/engram"
    },
    "figma-mcp": {
      "type": "http",
      "url": "https://mcp.figma.com/mcp"
    },
    "git": {
      "args": [
        "mcp-server-git"
      ],
      "command": "uvx",
      "type": "stdio"
    },
    "io.github.github/github-mcp-server": {
      "gallery": "https://api.mcp.github.com",
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "version": "1.0.3"
    },
    "next-devtools": {
      "args": [
        "-y",
        "next-devtools-mcp@latest"
      ],
      "command": "npx",
      "type": "stdio"
    },
    "sequential-thinking": {
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "command": "npx",
      "type": "stdio"
    }
  }
}
