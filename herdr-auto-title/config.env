# Auto Title plugin for Herdr (kryptamine/herdr-auto-title).
# Linked from ~/.config/herdr-auto-title/config.env. Read once at startup:
# apply changes with `herdr plugin action invoke herdr.auto-title.restart`.
# All settings: https://github.com/kryptamine/herdr-auto-title#configuration

# Nerd Font icon for what each pane runs, in front of its label.
HERDR_AUTO_TITLE_ICONS=true

# Agent status in front of the tab title: ◉ idle, ◐ working, ● blocked, ✓ done.
HERDR_AUTO_TITLE_AGENT_STATUS=true

# Shorter titles: no directory and no branch (the sidebar already shows the
# workspace and its branch), and at most 30 columns.
HERDR_AUTO_TITLE_DIRECTORY_MAX=0
HERDR_AUTO_TITLE_BRANCH_MAX=0
HERDR_AUTO_TITLE_MAX_LENGTH=30
